{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "playwright",
  "version": "0.1.2",
  "description": "Let an agent open web pages, click, fill forms, and take browser screenshots with Playwright.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/anthropics/claude-plugins-official/tree/ac996c0dde7fb2a9f805cd5277ffc95ecd44a321/external_plugins/playwright",
  "repository": "https://github.com/BANG404/openagent-playwright",
  "author": {
    "name": "Microsoft"
  },
  "extensions": {
    "openagent": {
      "compatibility": {
        "plugin_protocol": {
          "min": 1,
          "max": 1
        }
      },
      "capabilities": [
        "skills",
        "mcp",
        "commands"
      ],
      "mcp_tool_mode": "relay",
      "mcp_tool_modes": {
        "setup": "direct"
      },
      "commands": [
        {
          "id": "setup",
          "label": "Setup",
          "description": "Review connection prerequisites",
          "argument": "none",
          "command": "bin/command.mjs"
        }
      ],
      "i18n": {
        "supported_locales": [
          "en",
          "zh"
        ],
        "default_locale": "en",
        "translations": {
          "en": {
            "display_name": "Playwright Browser Automation",
            "description": "Let an agent open web pages, click, fill forms, and take browser screenshots with Playwright.",
            "commands.setup.label": "Setup",
            "commands.setup.description": "Review connection prerequisites"
          },
          "zh": {
            "display_name": "Playwright 浏览器自动化",
            "description": "让智能体通过 Playwright 打开网页、点击、填写表单和截取浏览器画面。",
            "commands.setup.label": "配置",
            "commands.setup.description": "查看连接要求"
          }
        }
      }
    }
  }
}
