{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "env": {
        "npm_config_cache": "${PLUGIN_DATA}/npm-cache",
        "npm_config_ignore_scripts": "true",
        "PLAYWRIGHT_BROWSERS_PATH": "${PLUGIN_DATA}/browsers"
      },
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--user-data-dir",
        "${PLUGIN_DATA}/browser-profile",
        "--output-dir",
        "${PLUGIN_DATA}/output"
      ],
      "type": "stdio"
    },
    "setup": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/bin/status.mjs"
      ]
    }
  }
}
